generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  name         String?
  passwordHash String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  memberships  OrganizationMember[]
}

model Organization {
  id               String               @id @default(cuid())
  name             String
  slug             String               @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  googleConnection GoogleConnection?
  memberships      OrganizationMember[]
  websites         Website[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole   @default(MEMBER)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Website {
  id                  String                @id @default(cuid())
  organizationId      String
  name                String
  url                 String
  industry            String?
  country             String?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  AeoAudit            AeoAudit[]
  AiVisibilityCheck   AiVisibilityCheck[]
  AiVisibilityQuery   AiVisibilityQuery[]
  AiVisibilitySummary AiVisibilitySummary[]
  Backlink            Backlink[]
  BacklinkDomain      BacklinkDomain[]
  BacklinkOpportunity BacklinkOpportunity[]
  BacklinkSnapshot    BacklinkSnapshot[]
  businessBrain       BusinessBrain?
  competitors         Competitor[]
  crawls              Crawl[]
  GeoAudit            GeoAudit[]
  GeoQuery            GeoQuery[]
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([url])
}

model Competitor {
  id             String            @id @default(cuid())
  organizationId String
  websiteId      String
  name           String
  url            String
  domain         String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  website        Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  crawls         CompetitorCrawl[]

  @@index([organizationId])
  @@index([websiteId])
  @@index([domain])
  @@index([url])
}

model CompetitorCrawl {
  id              String                @id @default(cuid())
  competitorId    String
  status          String                @default("RUNNING")
  pagesCrawled    Int                   @default(0)
  pagesDiscovered Int                   @default(0)
  score           Int                   @default(0)
  totalIssues     Int                   @default(0)
  critical        Int                   @default(0)
  high            Int                   @default(0)
  medium          Int                   @default(0)
  low             Int                   @default(0)
  startedAt       DateTime              @default(now())
  completedAt     DateTime?
  createdAt       DateTime              @default(now())
  competitor      Competitor            @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  pages           CompetitorCrawlPage[]

  @@index([competitorId])
  @@index([createdAt])
  @@index([status])
}

model CompetitorCrawlPage {
  id                  String          @id @default(cuid())
  competitorCrawlId   String
  url                 String
  statusCode          Int?
  title               String?
  metaDescription     String?
  canonical           String?
  canonicalAbsolute   String?
  h1                  String[]
  h2                  String[]
  images              Int             @default(0)
  imagesWithoutAlt    Int             @default(0)
  internalLinks       Int             @default(0)
  externalLinks       Int             @default(0)
  wordCount           Int             @default(0)
  robots              String?
  robotsIndexable     Boolean?
  robotsFollow        Boolean?
  viewport            String?
  lang                String?
  charset             String?
  ogTitle             String?
  ogDescription       String?
  ogImage             String?
  twitterCard         String?
  structuredDataCount Int             @default(0)
  jsonLd              Json?
  redirectCount       Int             @default(0)
  finalUrl            String?
  contentType         String?
  loadTimeMs          Int?
  createdAt           DateTime        @default(now())
  competitorCrawl     CompetitorCrawl @relation(fields: [competitorCrawlId], references: [id], onDelete: Cascade)

  @@index([competitorCrawlId])
  @@index([url])
  @@index([statusCode])
  @@index([wordCount])
}

model Crawl {
  id          String      @id @default(cuid())
  websiteId   String
  status      String      @default("COMPLETED")
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  website     Website     @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  pages       CrawlPage[]

  @@index([websiteId])
  @@index([createdAt])
}

model CrawlPage {
  id                  String     @id @default(cuid())
  crawlId             String
  url                 String
  statusCode          Int?
  title               String?
  metaDescription     String?
  canonical           String?
  h1                  String[]
  h2                  String[]
  images              Int        @default(0)
  imagesWithoutAlt    Int        @default(0)
  internalLinks       Int        @default(0)
  externalLinks       Int        @default(0)
  wordCount           Int        @default(0)
  robots              String?
  createdAt           DateTime   @default(now())
  robotsIndexable     Boolean?
  robotsFollow        Boolean?
  viewport            String?
  lang                String?
  charset             String?
  ogTitle             String?
  ogDescription       String?
  ogImage             String?
  twitterCard         String?
  structuredDataCount Int        @default(0)
  jsonLd              Json?
  canonicalAbsolute   String?
  redirectCount       Int        @default(0)
  finalUrl            String?
  contentType         String?
  loadTimeMs          Int?
  crawl               Crawl      @relation(fields: [crawlId], references: [id], onDelete: Cascade)
  issues              SeoIssue[]

  @@index([crawlId])
  @@index([url])
}

model SeoIssue {
  id             String           @id @default(cuid())
  crawlPageId    String
  code           String
  category       String
  severity       SeoIssueSeverity
  title          String
  description    String
  recommendation String
  status         SeoIssueStatus   @default(OPEN)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  crawlPage      CrawlPage        @relation(fields: [crawlPageId], references: [id], onDelete: Cascade)

  @@index([crawlPageId])
  @@index([code])
  @@index([severity])
  @@index([status])
}

model GoogleConnection {
  id                        String       @id @default(cuid())
  organizationId            String       @unique
  googleEmail               String?
  accessToken               String?
  refreshToken              String
  tokenExpiry               DateTime?
  selectedProperty          String?
  createdAt                 DateTime     @default(now())
  updatedAt                 DateTime     @updatedAt
  googleName                String?
  googlePicture             String?
  googleUserId              String
  scope                     String?
  selectedAnalyticsProperty String?
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([googleUserId])
}

model AeoAudit {
  id           String     @id
  websiteId    String
  score        Int        @default(0)
  pagesChecked Int        @default(0)
  issuesCount  Int        @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime
  Website      Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  AeoIssue     AeoIssue[]

  @@index([createdAt])
  @@index([websiteId])
}

model AeoIssue {
  id             String           @id
  auditId        String
  pageUrl        String?
  checkType      AeoCheckType
  status         AeoIssueStatus   @default(OPEN)
  severity       SeoIssueSeverity
  title          String
  description    String
  recommendation String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  AeoAudit       AeoAudit         @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([auditId])
  @@index([severity])
  @@index([status])
}

model AiVisibilityCheck {
  id              String                  @id
  websiteId       String
  platform        AiVisibilityPlatform
  query           String
  status          AiVisibilityCheckStatus @default(PENDING)
  mentioned       Boolean                 @default(false)
  citationFound   Boolean                 @default(false)
  position        Int?
  response        String?
  citationUrl     String?
  competitorNames String[]
  checkedAt       DateTime?
  errorMessage    String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  Website         Website                 @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([checkedAt])
  @@index([platform])
  @@index([status])
  @@index([websiteId])
  @@index([websiteId, platform])
}

model AiVisibilityQuery {
  id        String   @id
  websiteId String
  query     String
  category  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, query])
  @@index([isActive])
  @@index([websiteId])
}

model AiVisibilitySummary {
  id                 String   @id
  websiteId          String
  date               DateTime
  totalQueries       Int      @default(0)
  mentionedQueries   Int      @default(0)
  citedQueries       Int      @default(0)
  visibilityScore    Float    @default(0)
  citationRate       Float    @default(0)
  averagePosition    Float?
  competitorMentions Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime
  Website            Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date])
  @@index([date])
  @@index([websiteId])
}

model GeoAudit {
  id             String   @id
  websiteId      String
  overallScore   Int      @default(0)
  entityScore    Int      @default(0)
  citationScore  Int      @default(0)
  authorityScore Int      @default(0)
  contentScore   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  Website        Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([websiteId])
}

model GeoQuery {
  id        String           @id
  websiteId String
  query     String
  engine    VisibilityEngine
  mentioned Boolean          @default(false)
  cited     Boolean          @default(false)
  position  Int?
  response  String?
  checkedAt DateTime         @default(now())
  Website   Website          @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([checkedAt])
  @@index([engine])
  @@index([query])
  @@index([websiteId])
}

model Backlink {
  id              String   @id @default(cuid())
  websiteId       String
  sourceUrl       String
  targetUrl       String
  sourceDomain    String
  anchorText      String?
  linkType        String   @default("UNKNOWN")
  status          String   @default("ACTIVE")
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  domainAuthority Float?
  pageAuthority   Float?
  isToxic         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  website         Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([sourceDomain])
  @@index([targetUrl])
  @@index([status])
  @@index([lastSeenAt])
}

model BacklinkDomain {
  id             String   @id @default(cuid())
  websiteId      String
  domain         String
  backlinkCount  Int      @default(0)
  authorityScore Float    @default(0)
  dofollowCount  Int      @default(0)
  nofollowCount  Int      @default(0)
  toxicCount     Int      @default(0)
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  website        Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, domain])
  @@index([websiteId])
  @@index([authorityScore])
  @@index([backlinkCount])
}

model BacklinkSnapshot {
  id               String   @id @default(cuid())
  websiteId        String
  date             DateTime @default(now())
  totalBacklinks   Int      @default(0)
  referringDomains Int      @default(0)
  dofollowLinks    Int      @default(0)
  nofollowLinks    Int      @default(0)
  toxicLinks       Int      @default(0)
  authorityScore   Float    @default(0)
  newBacklinks     Int      @default(0)
  lostBacklinks    Int      @default(0)
  createdAt        DateTime @default(now())
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, date])
  @@index([websiteId])
  @@index([date])
}

model BacklinkOpportunity {
  id               String   @id @default(cuid())
  websiteId        String
  sourceDomain     String
  competitorId     String?
  targetUrl        String?
  anchorSuggestion String?
  opportunityType  String
  opportunityScore Int      @default(0)
  priority         String   @default("LOW")
  status           String   @default("OPEN")
  reason           String?
  suggestedAction  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([competitorId])
  @@index([opportunityScore])
  @@index([priority])
  @@index([status])
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SeoIssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SeoIssueStatus {
  OPEN
  FIXED
  IGNORED
}

enum AeoCheckType {
  ANSWER_READINESS
  FAQ
  STRUCTURED_DATA
  ENTITY
  CITATION
  CONTENT_DEPTH
  DIRECT_ANSWER
}

enum AeoIssueStatus {
  OPEN
  FIXED
  IGNORED
}

enum AiVisibilityCheckStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AiVisibilityPlatform {
  CHATGPT
  GOOGLE_AI
  GEMINI
  CLAUDE
  PERPLEXITY
  OTHER
}

enum VisibilityEngine {
  GOOGLE
  AI_OVERVIEW
  CHATGPT
  PERPLEXITY
  GEMINI
  CLAUDE
  BING_COPILOT
}
model BusinessBrain {
  id                  String   @id @default(cuid())

  websiteId           String   @unique

  businessName        String?
  industry            String?
  country             String?
  city                String?

  description         String?

  services            String[] @default([])
  products            String[] @default([])

  targetAudience      String?
  primaryGoal         String?

  primaryKeywords     String[] @default([])
  targetLocations     String[] @default([])

  brandTone           String?
  uniqueSellingPoint  String?

  aiSummary           String?

  businessScore       Int      @default(0)

  lastAnalyzedAt      DateTime?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  website             Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([businessScore])
}
