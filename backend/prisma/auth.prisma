// Auth email tokens (verification + password reset).
//
// Security properties:
// - Only SHA-256 hashes are stored; raw tokens are
//   delivered once via email and never persisted.
// - Tokens are single-use (usedAt) and expire
//   (expiresAt). Type distinguishes VERIFY / RESET.

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([expiresAt])
}
