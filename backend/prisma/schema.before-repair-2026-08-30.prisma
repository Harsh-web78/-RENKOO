generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum SeoIssueSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum SeoIssueStatus {
  OPEN
  FIXED
  IGNORED
}

enum AiVisibilityPlatform {
  CHATGPT
  GOOGLE_AI
  GEMINI
  CLAUDE
  PERPLEXITY
  OTHER
}

enum AiVisibilityCheckStatus {
  PENDING
  COMPLETED
  FAILED
}

enum VisibilityEngine {
  GOOGLE
  AI_OVERVIEW
  CHATGPT
  PERPLEXITY
  GEMINI
  CLAUDE
  BING_COPILOT
}

enum AeoCheckType {
  ANSWER_READINESS
  FAQ
  STRUCTURED_DATA
  ENTITY
  CITATION
  CONTENT_DEPTH
  DIRECT_ANSWER
}

enum AeoIssueStatus {
  OPEN
  FIXED
  IGNORED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships OrganizationMember[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships      OrganizationMember[]
  websites         Website[]
  googleConnection GoogleConnection?
}

model OrganizationMember {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(MEMBER)
  createdAt      DateTime   @default(now())

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Website {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  url            String
  industry       String?
  country        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  crawls Crawl[]

  aiVisibilityChecks    AiVisibilityCheck[]
  aiVisibilityQueries   AiVisibilityQuery[]
  aiVisibilitySummaries AiVisibilitySummary[]

  aeoAudits AeoAudit[]

  geoAudits  GeoAudit[]
  geoQueries GeoQuery[]

  @@index([organizationId])
  @@index([url])
}

model Crawl {
  id          String    @id @default(cuid())
  websiteId   String
  status      String    @default("COMPLETED")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  website Website @relation(
    fields: [websiteId],
    references: [id],
    onDelete: Cascade
  )

  pages CrawlPage[]

  @@index([websiteId])
  @@index([createdAt])
}

model CrawlPage {
  id      String @id @default(cuid())
  crawlId String
  url     String

  statusCode Int?

  title           String?
  metaDescription String?
  canonical       String?
  h1              String[]
  h2              String[]

  images           Int @default(0)
  imagesWithoutAlt Int @default(0)

  internalLinks Int @default(0)
  externalLinks Int @default(0)

  wordCount Int @default(0)

  robots          String?
  robotsIndexable Boolean?
  robotsFollow    Boolean?

  viewport String?
  lang     String?
  charset  String?

  ogTitle       String?
  ogDescription String?
  ogImage       String?
  twitterCard   String?

  structuredDataCount Int   @default(0)
  jsonLd              Json?

  canonicalAbsolute String?
  redirectCount     Int     @default(0)
  finalUrl          String?

  contentType String?
  loadTimeMs  Int?

  createdAt DateTime @default(now())

  crawl Crawl @relation(
    fields: [crawlId],
    references: [id],
    onDelete: Cascade
  )

  issues SeoIssue[]

  @@index([crawlId])
  @@index([url])
}

model SeoIssue {
  id             String           @id @default(cuid())
  crawlPageId    String
  code           String
  category       String
  severity       SeoIssueSeverity
  title          String
  description    String
  recommendation String

  status    SeoIssueStatus @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  crawlPage CrawlPage @relation(
    fields: [crawlPageId],
    references: [id],
    onDelete: Cascade
  )

  @@index([crawlPageId])
  @@index([code])
  @@index([severity])
  @@index([status])
}

model AiVisibilityQuery {
  id        String  @id @default(cuid())
  websiteId String
  query     String
  category  String?
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(
    fields: [websiteId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([websiteId, query])
  @@index([websiteId])
  @@index([isActive])
}

model AiVisibilityCheck {
  id        String @id @default(cuid())
  websiteId String

  platform AiVisibilityPlatform
  query    String
  status   AiVisibilityCheckStatus @default(PENDING)

  mentioned     Boolean @default(false)
  citationFound Boolean @default(false)

  position Int?

  response String?

  citationUrl String?

  competitorNames String[]

  checkedAt DateTime?

  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(
    fields: [websiteId],
    references: [id],
    onDelete: Cascade
  )

  @@index([websiteId])
  @@index([platform])
  @@index([status])
  @@index([checkedAt])
  @@index([websiteId, platform])
}

model AiVisibilitySummary {
  id        String   @id @default(cuid())
  websiteId String
  date      DateTime

  totalQueries     Int @default(0)
  mentionedQueries Int @default(0)
  citedQueries     Int @default(0)

  visibilityScore Float @default(0)
  citationRate    Float @default(0)

  averagePosition    Float?
  competitorMentions Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(
    fields: [websiteId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([websiteId, date])
  @@index([websiteId])
  @@index([date])
}

model GoogleConnection {
  id             String @id
  organizationId String @unique

  googleUserId  String
  googleEmail   String?
  googleName    String?
  googlePicture String?

  accessToken  String?
  refreshToken String
  tokenExpiry  DateTime?
  scope        String?

  selectedProperty          String?
  selectedAnalyticsProperty String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(
    fields: [organizationId],
    references: [id],
    onDelete: Cascade
  )

  @@index([googleUserId])
}

model AeoAudit {
  id           String   @id @default(cuid())
  websiteId    String
  score        Int      @default(0)
  pagesChecked Int      @default(0)
  issuesCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  website Website @relation(
    fields: [websiteId],
    references: [id],
    onDelete: Cascade
  )

  issues AeoIssue[]

  @@index([websiteId])
  @@index([createdAt])
}

model AeoIssue {
  id             String          @id @default(cuid())
  auditId        String
  pageUrl        String?
  checkType      AeoCheckType
  status         AeoIssueStatus  @default(OPEN)
  severity       SeoIssueSeverity
  title          String
  description    String
  recommendation String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  audit AeoAudit @relation(
    fields: [auditId],
    references: [id],
    onDelete: Cascade
  )

  @@index([auditId])
  @@index([status])
  @@index([severity])
}

model GeoAudit {
  id             String   @id @default(cuid())
  websiteId      String
  overallScore   Int      @default(0)
  entityScore    Int      @default(0)
  citationScore  Int      @default(0)
  authorityScore Int      @default(0)
  contentScore   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  website Website @relation(
    fields: [websiteId],
    references: [id],
    onDelete: Cascade
  )

  @@index([websiteId])
  @@index([createdAt])
}

model GeoQuery {
  id        String          @id @default(cuid())
  websiteId String
  query     String
  engine    VisibilityEngine
  mentioned Boolean         @default(false)
  cited     Boolean         @default(false)
  position  Int?
  response  String?
  checkedAt DateTime        @default(now())

  website Website @relation(
    fields: [websiteId],
    references: [id],
    onDelete: Cascade
  )

  @@index([websiteId])
  @@index([engine])
  @@index([query])
  @@index([checkedAt])
}
