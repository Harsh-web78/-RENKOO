PORT=4000
DATABASE_URL="postgresql://renkoo:renkoo_dev_password@localhost:5432/renkoo?schema=public"
# REDIS_URL is currently UNUSED by the API (no cache/queue wiring).
# Reserved for future use; the provisioned Redis container is optional.
REDIS_URL="redis://localhost:6379"
FRONTEND_URL="http://localhost:3000"
JWT_ACCESS_SECRET="change-this-local-secret"
JWT_REFRESH_SECRET="change-this-local-refresh-secret"

# --- Transactional email (Resend) ---
# Server-only. Never expose to the frontend, never log, never commit real values.
RESEND_API_KEY=
# Verified sender address, e.g. "RENKOO <hello@yourdomain.com>".
# Required for production delivery. Without it, the API falls back to the
# Resend test sender (onboarding@resend.dev), which is delivery-limited.
EMAIL_FROM=
# Optional second sender fallback (used only when EMAIL_FROM is empty).
RESEND_FROM_EMAIL=
# Public application URL used to build verification, reset, invite, and
# report share links in emails. Production: "https://renkoo.online".
APP_PUBLIC_URL="http://localhost:3000"

# --- Google OAuth token encryption (server-only) ---
# Strong random secret used to encrypt Google OAuth tokens at rest (AES-256-GCM).
# Existing plaintext rows keep working and migrate lazily on next write.
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (Search Console + Analytics) ---
# REQUIRED for Google integrations. Missing values make the OAuth client
# throw a clear configuration error per request (no silent failure).
# GOOGLE_REDIRECT_URI must exactly match a redirect URI registered in the
# Google Cloud console, e.g. production:
# "https://renkoo-backend.onrender.com/api/google/callback".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# --- AI visibility providers (server-only, never expose to frontend) ---
GEMINI_API_KEY=
# Override only if you need a different stable Gemini model.
GEMINI_MODEL="gemini-3.6-flash"
OPENAI_API_KEY=
# Override only if you need a different OpenAI model.
OPENAI_MODEL="gpt-4o-mini"

# --- Billing: Razorpay (PRIMARY provider, server-only) ---
# Public Key ID is returned inside checkout payloads only; the secret and
# webhook secret never leave the backend and are never logged.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_MODE=test (rzp_test_ keys) or live (rzp_live_ keys). Defaults to
# test unless a live key is detected.
RAZORPAY_MODE=test
# USD checkout stays disabled until Razorpay confirms international-cards
# activation. Set to AVAILABLE only after that confirmation.
RAZORPAY_INTERNATIONAL_CARDS=

# --- Billing: Stripe (SECONDARY / future provider, server-only) ---
# Preserved for future use. Razorpay remains the primary provider.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Internal test account (server-only, never expose to frontend) ---
# Exact email of the single designated internal testing workspace member.
# When set, that member's workspace receives an explicit INTERNAL
# entitlement (unlimited product use, no subscription). When empty or
# missing, the override is completely disabled and all commercial
# behavior is unchanged. Never commit a real address here.
INTERNAL_TEST_EMAIL=

# --- Error monitoring (lightweight, Sentry-compatible, server-only) ---
# Optional. When empty, backend logging stays local-only and dev is unaffected.
# Never send secrets or raw customer data; only sanitized method/path/status.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# --- Website crawler tuning (server-only, all optional) ---
# Defaults preserve production behavior; values are clamped to safe ranges.
# CRAWL_MAX_PAGES: pages per crawl (1-200, default 50).
# CRAWL_PAGE_CONCURRENCY: parallel page fetches (1-10, default 5).
# CRAWL_PAGE_TIMEOUT_MS: per-page navigation cap (5000-120000, default 30000).
# CRAWL_MAX_TIME_MS: absolute per-crawl cap (60000-1800000, default 480000).
# The Playwright browser binary is installed via the `postinstall` script
# (`npx playwright install chromium`); no env var is required for it.
# CRAWL_MAX_PAGES=50
# CRAWL_PAGE_CONCURRENCY=5
# CRAWL_PAGE_TIMEOUT_MS=30000
# CRAWL_MAX_TIME_MS=480000

# --- Keyword research provider: DataForSEO (server-only) ---
# Real search volume, KD, CPC, trend, intent, competitor
# keywords and SERP. Pay-as-you-go on your DataForSEO
# balance; RENKOO caches aggressively and meters fresh
# lookups via API_CALLS (paid) or a monthly free allowance.
# When empty, research degrades to crawl/GSC evidence with
# explicit "unavailable" labels — nothing is faked.
# Never commit real values. Never expose to the frontend.
KEYWORD_DATA_PROVIDER=dataforseo
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Optional: true routes calls to the free DataForSEO sandbox
# (sample responses, no billing) for integration testing.
# DATAFORSEO_SANDBOX=false
# Optional overrides (defaults shown).
# DATAFORSEO_BASE_URL=https://api.dataforseo.com
# DATAFORSEO_TIMEOUT_MS=25000
# SERP-overlap clustering threshold (Jaccard 0.1–0.9).
# 0.40 ≈ ≥4 shared top-10 URLs. Calibrated: topical
# neighbors share 1–3 URLs; same-intent variants 4–8.
# SERP_SIMILARITY_THRESHOLD=0.40

# --- Public AI Visibility Snapshot (anonymous, server-only) ---
# Strictly bounded provider spend. In-memory cache/limits reset on restart
# and do not span horizontally. No billing, no Prisma writes, no entitlements.
SNAPSHOT_MAX_CALLS_PER_RUN=6
SNAPSHOT_DOMAIN_CACHE_TTL_HOURS=24
SNAPSHOT_MAX_REQUESTS_PER_IP_PER_HOUR=5
SNAPSHOT_MAX_REQUESTS_PER_DOMAIN_PER_DAY=3
SNAPSHOT_MONTHLY_CALL_BUDGET=500

# --- AI Prompt Monitoring ops (Phase 7/8A, server-only) ---
# External cron trilogy (authenticated by scheduler secret, repeat safely):
#   POST /api/monitoring/internal/due            claim due schedules (fast)
#   POST /api/monitoring/internal/execute-next   run oldest QUEUED run (repeat
#                                               until { executed: false })
#   POST /api/monitoring/internal/recover        fail stale RUNNING rows
# AI_MONITOR_SCHEDULER_SECRET: shared secret for x-scheduler-secret.
# Minimum 16 chars. When empty, internal tick routes 503 (never open).
# Never commit a real value. Never expose to the frontend. Never log it.
# AI_MONITOR_SCHEDULER_SECRET=
# Bounded execution + recovery (defaults preserve production behavior):
# AI_MONITOR_BATCH_SIZE=5            prompts per batch (1-25)
# AI_MONITOR_CONCURRENCY=2           parallel provider calls (1-4)
# AI_MONITOR_PROVIDER_TIMEOUT_MS=30000   per-call cap (hangs become failures, free)
# AI_MONITOR_RUN_TIMEOUT_MS=600000   absolute per-run cap
# AI_MONITOR_MAX_RETRIES=1           retry passes over FAILED units only (0-2)
# AI_MONITOR_STALE_RUN_MS=1800000    RUNNING older than this is recovered FAILED
# AI_MONITOR_HEARTBEAT_MS=90000      throttled RUNNING heartbeat (60-120s).
#                                    Live long runs keep beating and are
#                                    never falsely recovered; crashed
#                                    workers go silent and recover cleanly.
# AI_MONITOR_RETENTION_DAYS=         empty = keep forever (conservative).
#                                    Set N to enable privileged prune of rows
#                                    older than N days (latest observation per
#                                    prompt×surface is always kept).
