# --- Frontend (Vercel) ---
# Public backend base URL, baked in at build time.
# Production: "https://renkoo-backend.onrender.com/api" (no trailing slash).
# Local development: "http://localhost:4000/api".
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
# Public legal/company contact shown on /privacy (account deletion, rights).
# Falls back to the existing project contact when unset; no placeholder is rendered.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=""
# Optional lightweight error-monitoring DSN (Sentry-compatible).
# When empty, monitoring is a sanitized no-op and local dev is unaffected.
NEXT_PUBLIC_SENTRY_DSN=""
